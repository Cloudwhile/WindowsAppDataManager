{
  "$schema": "../schema.json",
  "id": "visual-studio-code",
  "version": "1",
  "name": "Visual Studio Code",
  "publisher": "Microsoft Corporation",
  "applicationCategory": "开发工具",
  "executablePath": "%LOCALAPPDATA%/Programs/Microsoft VS Code/Code.exe",
  "installPath": "%LOCALAPPDATA%/Programs/Microsoft VS Code",
  "identifiers": {
    "registryDisplayNames": [
      "Microsoft Visual Studio Code",
      "Microsoft Visual Studio Code (User)"
    ],
    "registryPublishers": ["Microsoft Corporation"],
    "executableProductNames": ["Visual Studio Code"],
    "executableCompanyNames": ["Microsoft Corporation"],
    "executableOriginalFilenames": ["Code.exe"],
    "authenticodePublishers": ["Microsoft Corporation"],
    "runningProcessNames": ["Code.exe"]
  },
  "locations": [
    { "scope": "roaming", "path": "Code", "ownership": "exclusive" }
  ],
  "entries": [
    {
      "id": "cache",
      "path": "Cache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "资源缓存会在编辑器后续运行时重新生成。"
    },
    {
      "id": "cached-data",
      "path": "CachedData",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "版本缓存可重新生成，下一次启动可能稍慢。"
    },
    {
      "id": "code-cache",
      "path": "Code Cache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "脚本缓存会在后续启动和使用过程中重新生成。"
    },
    {
      "id": "gpu-cache",
      "path": "GPUCache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "图形缓存会重新生成，首次显示界面可能稍慢。"
    },
    {
      "id": "logs",
      "path": "logs",
      "category": "log",
      "risk": "low",
      "rebuildable": true,
      "impact": "旧诊断记录会被移除，编辑器仍会生成新日志。"
    },
    {
      "id": "workspace-storage",
      "path": "User/workspaceStorage",
      "category": "workspace",
      "risk": "high",
      "rebuildable": false,
      "impact": "可能丢失工作区界面状态、扩展状态或未同步的本地信息。"
    },
    {
      "id": "global-storage",
      "path": "User/globalStorage",
      "category": "user-data",
      "risk": "protected",
      "rebuildable": false,
      "impact": "可能包含扩展和编辑器持久状态，不应自动处理。"
    },
    {
      "id": "user-history",
      "path": "User/History",
      "category": "user-data",
      "risk": "high",
      "rebuildable": false,
      "impact": "包含本地文件历史，未保存或未同步的版本可能无法恢复。"
    },
    {
      "id": "user-settings",
      "path": "User/settings.json",
      "category": "config",
      "risk": "protected",
      "rebuildable": false,
      "impact": "包含用户设置，默认禁止处理。"
    },
    {
      "id": "user-keybindings",
      "path": "User/keybindings.json",
      "category": "config",
      "risk": "protected",
      "rebuildable": false,
      "impact": "包含用户快捷键设置，默认禁止处理。"
    },
    {
      "id": "user-snippets",
      "path": "User/snippets",
      "category": "user-data",
      "risk": "protected",
      "rebuildable": false,
      "impact": "包含用户代码片段，默认禁止处理。"
    },
    {
      "id": "session-storage",
      "path": "Session Storage",
      "category": "session",
      "risk": "high",
      "rebuildable": false,
      "impact": "包含编辑器会话状态，移除后可能丢失未同步状态。"
    },
    {
      "id": "local-storage",
      "path": "Local Storage",
      "category": "session",
      "risk": "high",
      "rebuildable": false,
      "impact": "包含编辑器和扩展的本地状态，移除后可能造成数据丢失。"
    },
    {
      "id": "indexed-db",
      "path": "IndexedDB",
      "category": "database",
      "risk": "high",
      "rebuildable": false,
      "impact": "包含编辑器或扩展数据库，移除后可能造成不可恢复的数据丢失。"
    },
    {
      "id": "cookies",
      "path": "Cookies",
      "category": "cookie",
      "risk": "high",
      "rebuildable": false,
      "impact": "可能包含扩展登录会话，移除后可能导致退出登录。"
    },
    {
      "id": "network-cookies",
      "path": "Network/Cookies",
      "category": "cookie",
      "risk": "high",
      "rebuildable": false,
      "impact": "可能包含扩展登录会话，移除后可能导致退出登录。"
    },
    {
      "id": "local-state",
      "path": "Local State",
      "category": "config",
      "risk": "protected",
      "rebuildable": false,
      "impact": "包含编辑器级配置和加密数据相关状态，默认禁止处理。"
    }
  ]
}
