{
  "$schema": "../schema.json",
  "id": "windows-temp",
  "version": "1",
  "name": "Windows 临时数据",
  "publisher": "Microsoft Windows",
  "applicationCategory": "系统",
  "executablePath": "%SystemRoot%/explorer.exe",
  "installPath": "%SystemRoot%",
  "identifiers": {
    "executableProductNames": ["Microsoft® Windows® Operating System"],
    "executableCompanyNames": ["Microsoft Corporation"],
    "authenticodePublishers": ["Microsoft Windows"]
  },
  "locations": [
    { "scope": "local", "path": "Temp", "ownership": "shared" }
  ],
  "entries": [
    {
      "id": "crash-dumps",
      "path": "CrashDumps",
      "category": "crash-dump",
      "risk": "low",
      "rebuildable": false,
      "impact": "移除后无法继续分析这些旧崩溃，不影响系统正常运行。"
    },
    {
      "id": "diagnostic-logs",
      "path": "Diagnostics",
      "category": "log",
      "risk": "low",
      "rebuildable": true,
      "impact": "旧诊断记录会被移除，系统和应用仍可生成新记录。"
    }
  ]
}
