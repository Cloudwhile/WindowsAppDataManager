{
  "$schema": "../schema.json",
  "id": "jetbrains",
  "version": "1",
  "name": "JetBrains IDE",
  "publisher": "JetBrains s.r.o.",
  "applicationCategory": "开发工具",
  "executablePath": "%LOCALAPPDATA%/JetBrains/Toolbox/bin/jetbrains-toolbox.exe",
  "installPath": "%LOCALAPPDATA%/JetBrains/Toolbox",
  "identifiers": {
    "executableProductNames": ["JetBrains Toolbox"],
    "executableCompanyNames": ["JetBrains s.r.o."],
    "executableOriginalFilenames": ["jetbrains-toolbox.exe"],
    "authenticodePublishers": ["JetBrains s.r.o."]
  },
  "locations": [
    { "scope": "local", "path": "JetBrains", "ownership": "shared", "role": "vendor-namespace" },
    { "scope": "roaming", "path": "JetBrains", "ownership": "shared", "role": "vendor-namespace" }
  ],
  "entries": [
    {
      "id": "versioned-product-data",
      "path": ".",
      "category": "user-data",
      "risk": "protected",
      "rebuildable": false,
      "impact": "该目录由多个 IDE 和版本共享，包含配置、插件、索引及项目状态；无法用固定路径安全区分，默认禁止处理。"
    }
  ]
}
