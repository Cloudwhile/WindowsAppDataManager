{
  "$schema": "../schema.json",
  "id": "microsoft-teams-classic",
  "version": "1",
  "name": "Microsoft Teams Classic",
  "publisher": "Microsoft Corporation",
  "applicationCategory": "通讯",
  "executablePath": "%LOCALAPPDATA%/Microsoft/Teams/current/Teams.exe",
  "installPath": "%LOCALAPPDATA%/Microsoft/Teams",
  "identifiers": {
    "registryDisplayNames": ["Microsoft Teams"],
    "executableProductNames": ["Microsoft Teams"],
    "executableCompanyNames": ["Microsoft Corporation"],
    "executableOriginalFilenames": ["Teams.exe"],
    "runningProcessNames": ["Teams.exe"]
  },
  "locations": [
    { "scope": "roaming", "path": "Microsoft/Teams", "ownership": "exclusive" }
  ],
  "entries": [
    {
      "id": "cache",
      "path": "Cache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "消息和界面缓存会在 Teams 再次使用时重新生成。"
    },
    {
      "id": "code-cache",
      "path": "Code Cache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "脚本缓存会在后续启动和使用过程中重新生成。"
    },
    {
      "id": "gpu-cache",
      "path": "GPUCache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "图形缓存会重新生成，首次显示界面可能稍慢。"
    },
    {
      "id": "logs",
      "path": "logs",
      "category": "log",
      "risk": "low",
      "rebuildable": true,
      "impact": "旧诊断记录会被移除，Teams 仍会生成新日志。"
    },
    {
      "id": "indexed-db",
      "path": "IndexedDB",
      "category": "database",
      "risk": "high",
      "rebuildable": false,
      "impact": "可能包含离线状态和扩展数据，移除后可能需要重新登录。"
    },
    {
      "id": "local-storage",
      "path": "Local Storage",
      "category": "session",
      "risk": "high",
      "rebuildable": false,
      "impact": "包含账号和工作区本地状态，移除后可能丢失未同步信息。"
    },
    {
      "id": "local-state",
      "path": "Local State",
      "category": "config",
      "risk": "protected",
      "rebuildable": false,
      "impact": "包含 Teams 配置和加密数据相关状态，默认禁止处理。"
    }
  ]
}
