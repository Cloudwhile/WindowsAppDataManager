{
  "$schema": "../schema.json",
  "id": "postman",
  "version": "1",
  "name": "Postman",
  "publisher": "Postman, Inc.",
  "applicationCategory": "开发工具",
  "executablePath": "%LOCALAPPDATA%/Postman/Postman.exe",
  "installPath": "%LOCALAPPDATA%/Postman",
  "identifiers": {
    "registryDisplayNames": ["Postman"],
    "executableProductNames": ["Postman"],
    "executableCompanyNames": ["Postman, Inc."],
    "executableOriginalFilenames": ["Postman.exe"],
    "runningProcessNames": ["Postman.exe"]
  },
  "locations": [
    { "scope": "roaming", "path": "Postman", "ownership": "exclusive" }
  ],
  "entries": [
    {
      "id": "cache",
      "path": "Cache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "接口资源缓存会在 Postman 再次使用时重新生成。"
    },
    {
      "id": "code-cache",
      "path": "Code Cache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "脚本缓存会在后续启动和使用过程中重新生成。"
    },
    {
      "id": "gpu-cache",
      "path": "GPUCache",
      "category": "cache",
      "risk": "safe",
      "rebuildable": true,
      "impact": "图形缓存会重新生成，首次显示界面可能稍慢。"
    },
    {
      "id": "logs",
      "path": "logs",
      "category": "log",
      "risk": "low",
      "rebuildable": true,
      "impact": "旧诊断记录会被移除，Postman 仍会生成新日志。"
    },
    {
      "id": "indexed-db",
      "path": "IndexedDB",
      "category": "database",
      "risk": "high",
      "rebuildable": false,
      "impact": "可能包含工作区和离线数据，移除后可能造成数据丢失。"
    },
    {
      "id": "local-storage",
      "path": "Local Storage",
      "category": "user-data",
      "risk": "protected",
      "rebuildable": false,
      "impact": "可能包含集合、环境和未同步数据，默认禁止处理。"
    },
    {
      "id": "local-state",
      "path": "Local State",
      "category": "config",
      "risk": "protected",
      "rebuildable": false,
      "impact": "包含应用配置和加密状态，默认禁止处理。"
    }
  ]
}
