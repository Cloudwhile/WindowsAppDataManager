{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windowsappdatamanager.local/rules/schema.json",
  "title": "Windows AppData Manager application rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "publisher",
    "applicationCategory",
    "locations",
    "entries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "applicationCategory": { "type": "string", "minLength": 1 },
    "executablePath": { "$ref": "#/$defs/absoluteRulePath" },
    "installPath": { "$ref": "#/$defs/absoluteRulePath" },
    "executables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": { "path": { "$ref": "#/$defs/absoluteRulePath" } }
      }
    },
    "installPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/absoluteRulePath" }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "allOf": [
        {
          "if": { "required": ["registryPublishers"] },
          "then": { "required": ["registryDisplayNames"] }
        },
        {
          "if": { "required": ["appxPublishers"] },
          "then": { "required": ["appxPackageNames"] }
        }
      ],
      "properties": {
        "registryDisplayNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "registryPublishers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "appxPackageNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "appxPublishers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "executableProductNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "executableCompanyNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "executableOriginalFilenames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "authenticodePublishers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "runningProcessNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/processName" }
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "path"],
        "properties": {
          "scope": { "enum": ["local", "roaming", "locallow"] },
          "path": { "$ref": "#/$defs/relativeLocationPath" },
          "ownership": { "enum": ["shared", "exclusive"] },
          "role": {
            "enum": ["data", "config", "cache", "shared-data",
                     "install-payload", "vendor-namespace", "mixed"]
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "risk", "rebuildable", "impact"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "path": { "$ref": "#/$defs/relativeEntryPath" },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relativeEntryPath" }
          },
          "category": {
            "enum": [
              "unknown", "cache", "log", "temp", "crash-dump", "config",
              "database", "session", "cookie", "credential", "user-data",
              "workspace", "save-game", "downloaded-resource", "extension"
            ]
          },
          "risk": { "enum": ["safe", "low", "caution", "high", "protected", "unknown"] },
          "rebuildable": {
            "oneOf": [
              { "type": "boolean" },
              { "const": "unknown" }
            ]
          },
          "impact": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "allOf": [
          {
            "anyOf": [
              { "required": ["path"] },
              { "required": ["paths"] }
            ]
          },
          {
            "if": {
              "properties": { "risk": { "const": "safe" } },
              "required": ["risk"]
            },
            "then": {
              "properties": {
                "category": { "enum": ["cache", "temp", "downloaded-resource"] },
                "rebuildable": { "const": true },
                "path": { "not": { "const": "." } }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "enum": [
                    "database", "session", "cookie", "credential", "user-data",
                    "workspace", "save-game"
                  ]
                }
              },
              "required": ["category"]
            },
            "then": {
              "properties": {
                "risk": { "enum": ["caution", "high", "protected", "unknown"] }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "required": ["executablePath"] },
        { "required": ["executables"] }
      ]
    },
    {
      "anyOf": [
        { "required": ["installPath"] },
        { "required": ["installPaths"] }
      ]
    }
  ],
  "$defs": {
    "absoluteRulePath": {
      "type": "string",
      "minLength": 1,
      "oneOf": [
        {
          "pattern": "^[A-Za-z]:[\\\\/][^%:]*$"
        },
        {
          "pattern": "^%(?:LOCALAPPDATA|APPDATA|USERPROFILE|SystemRoot|ProgramFiles|ProgramFiles\\(x86\\))%(?:[\\\\/][^%:]*)?$"
        }
      ],
      "not": {
        "pattern": "(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)"
      }
    },
    "relativeLocationPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?![\\\\/])(?!.*[\\\\/]$)(?!.*[<>:\"|?*%\\u0000-\\u001F])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))(?!.*[ .](?:[\\\\/]|$)).+$",
      "$comment": "运行时还会拒绝 DOS 保留设备名，并按 Windows 大小写不敏感规则检查冲突。"
    },
    "relativeEntryPath": {
      "oneOf": [
        { "const": "." },
        { "$ref": "#/$defs/relativeLocationPath" },
        { "$ref": "#/$defs/relativeGlobPath" }
      ]
    },
    "relativeGlobPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?![\\/])(?!.*[\\/]$)(?!.*[<>:\"|?%\\u0000-\\u001F])(?!.*(?:^|[\\/])\\.{1,2}(?:[\\/]|$)).+$"
    },
    "processName": {
      "type": "string",
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\\\/:<>\"|?*\\u0000-\\u001F])(?=.+\\.[Ee][Xx][Ee]$).+$"
    }
  }
}
