{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windowsappdatamanager.local/rules/schema.json",
  "title": "Windows AppData Manager application rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "publisher",
    "applicationCategory",
    "executablePath",
    "installPath",
    "locations",
    "entries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "applicationCategory": { "type": "string", "minLength": 1 },
    "executablePath": { "$ref": "#/$defs/absoluteRulePath" },
    "installPath": { "$ref": "#/$defs/absoluteRulePath" },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "allOf": [
        {
          "if": { "required": ["registryPublishers"] },
          "then": { "required": ["registryDisplayNames"] }
        },
        {
          "if": { "required": ["appxPublishers"] },
          "then": { "required": ["appxPackageNames"] }
        }
      ],
      "properties": {
        "registryDisplayNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "registryPublishers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "appxPackageNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "appxPublishers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "executableProductNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "executableCompanyNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "executableOriginalFilenames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "authenticodePublishers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "path"],
        "properties": {
          "scope": { "enum": ["local", "roaming", "locallow"] },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "category", "risk", "rebuildable", "impact"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "unknown", "cache", "log", "temp", "crash-dump", "config",
              "database", "session", "cookie", "credential", "user-data",
              "workspace", "save-game", "downloaded-resource", "extension"
            ]
          },
          "risk": { "enum": ["safe", "low", "caution", "high", "protected", "unknown"] },
          "rebuildable": {
            "oneOf": [
              { "type": "boolean" },
              { "const": "unknown" }
            ]
          },
          "impact": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "absoluteRulePath": {
      "type": "string",
      "minLength": 1,
      "oneOf": [
        {
          "pattern": "^[A-Za-z]:[\\\\/][^%:]*$"
        },
        {
          "pattern": "^%(?:LOCALAPPDATA|APPDATA|USERPROFILE|SystemRoot|ProgramFiles|ProgramFiles\\(x86\\))%(?:[\\\\/][^%:]*)?$"
        }
      ],
      "not": {
        "pattern": "(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)"
      }
    }
  }
}
